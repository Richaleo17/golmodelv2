# Llaves gratuitas. Si falta una, ese proveedor se omite de su cadena de respaldo.
API_FOOTBALL_KEY=
ODDS_API_KEY=
FOOTBALL_DATA_ORG_KEY=
THESPORTSDB_KEY=123
POSTGRES_PASSWORD=cambia_esto
# Contraseñas de la app (solo letras y números). VACÍAS = la app no muestra nada hasta que las pongas.
# Con ellas puedes abrirla desde el celular y compartirla (pantalla completa en :8501 y app del celular en :8000/app/).
# APP_PASSWORD: tú (todo). APP_VIEWER_PASSWORD: tu amigo (solo consulta).
APP_PASSWORD=
APP_VIEWER_PASSWORD=
# Para dejarla solo en tu computadora y sin contraseña, descomenta la siguiente línea:
# UI_BIND=127.0.0.1
